{
    "openapi": "3.0.0",
    "info": {
        "title": "Project Management API",
        "description": "API documentation for the project management platform",
        "version": "1.0.0"
    },
    "paths": {
        "/api/auth/github/redirect": {
            "get": {
                "tags": [
                    "Auth - GitHub"
                ],
                "summary": "Redirect to the GitHub authorization page",
                "description": "Redirects the user to the GitHub OAuth page to authorize the application.",
                "operationId": "142ff0f591d1698e9f4bd39635076df6",
                "responses": {
                    "302": {
                        "description": "Redirect to github.com/login/oauth/authorize"
                    }
                }
            }
        },
        "/api/auth/github/callback": {
            "get": {
                "tags": [
                    "Auth - GitHub"
                ],
                "summary": "GitHub OAuth callback",
                "description": "Creates/updates the user and returns a Sanctum token.",
                "operationId": "aa7596359b6d521c12ac1d071337548f",
                "parameters": [
                    {
                        "name": "code",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Authentication successful"
                    },
                    "401": {
                        "description": "GitHub authentication failed"
                    }
                }
            }
        },
        "/api/auth/refresh": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Refresh the access token",
                "description": "Requires a valid, non-expired refresh token sent as Bearer token. Rotates both tokens.",
                "operationId": "e760c9efdbf86b4c43f957e7849a7bc4",
                "responses": {
                    "200": {
                        "description": "New token pair issued"
                    },
                    "401": {
                        "description": "Refresh token missing, invalid or expired"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/auth/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Revoke current auth tokens",
                "operationId": "aa30070c226ed03cad6e2b80ac458520",
                "responses": {
                    "200": {
                        "description": "Logged out"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "Sanctum",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Auth - GitHub",
            "description": "User authentication via GitHub"
        },
        {
            "name": "Auth",
            "description": "Token lifecycle"
        }
    ]
}